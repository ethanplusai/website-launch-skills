---
import SiteForm from '../components/SiteForm.astro'
---
<main>
  <h1>Contact the practice</h1>
  <p>Tell us what you are after and we will reply within a working day.</p>
  <label>Your website <input type="url" name="website" placeholder="https://example.com"></label>
  <label>Your email <input type="email" name="reply" placeholder="you@example.com"></label>
  <SiteForm form="contact" />
</main>
